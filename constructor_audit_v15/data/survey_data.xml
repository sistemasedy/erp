    <field name="answer_score">0</field><field name="sequence">1</field>
</record>
<record id="q_p4_b" model="survey.question.answer">
    <field name="question_id" ref="q_p4"/><field name="value">Mensualmente, con retraso por falta de comprobantes</field>
    <field name="answer_score">3</field><field name="sequence">2</field>
</record>
<record id="q_p4_c" model="survey.question.answer">
    <field name="question_id" ref="q_p4"/><field name="value">Por avance certificado, con conciliación tardía</field>
    <field name="answer_score">7</field><field name="sequence">3</field>
</record>
<record id="q_p4_d" model="survey.question.answer">
    <field name="question_id" ref="q_p4"/><field name="value">Por hitos, con proyección a 30/60/90 días</field>
    <field name="answer_score">10</field><field name="sequence">4</field>
</record>

<!-- P5 -->
<record id="q_p5" model="survey.question">
    <field name="survey_id" ref="survey_constructor_audit"/>
