<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

<record id="survey_constructor_audit" model="survey.survey">
    <field name="title">Inspección de Resistencia Operativa</field>
    <field name="access_mode">public</field>
    <field name="users_login_required" eval="False"/>
    <field name="scoring_type">scoring_without_answers</field>
    <field name="questions_layout">page_per_question</field>
    <field name="x_is_audit_survey" eval="True"/>
    <field name="description">&lt;p&gt;Inspección técnica de eficiencia operativa para constructoras. 10 preguntas, 5 minutos, resultados inmediatos.&lt;/p&gt;</field>
</record>

<!-- P1 -->
<record id="q_p1" model="survey.question">
    <field name="survey_id" ref="survey_constructor_audit"/>
    <field name="title">¿Cómo detectas las fugas de presupuesto en obra?</field>
    <field name="question_type">simple_choice</field>
    <field name="constr_mandatory" eval="True"/>
    <field name="sequence">10</field>
    <field name="question_code">p1</field>
</record>
<record id="q_p1_a" model="survey.question.answer">
    <field name="question_id" ref="q_p1"/><field name="value">No llevo control / Reviso al finalizar</field>
    <field name="answer_score">0</field><field name="sequence">1</field>
</record>
<record id="q_p1_b" model="survey.question.answer">
    <field name="question_id" ref="q_p1"/><field name="value">En Excel, con actualizaciones manuales semanales</field>
    <field name="answer_score">3</field><field name="sequence">2</field>
</record>
<record id="q_p1_c" model="survey.question.answer">
    <field name="question_id" ref="q_p1"/><field name="value">Software especializado, desconectado de compras</field>
    <field name="answer_score">7</field><field name="sequence">3</field>
</record>
<record id="q_p1_d" model="survey.question.answer">
    <field name="question_id" ref="q_p1"/><field name="value">En tiempo real con alertas automáticas vinculadas a flujo de caja</field>
    <field name="answer_score">10</field><field name="sequence">4</field>
</record>

<!-- P2 -->
<record id="q_p2" model="survey.question">
    <field name="survey_id" ref="survey_constructor_audit"/>
    <field name="title">¿Cómo solicitas y apruebas la compra de materiales?</field>
    <field name="question_type">simple_choice</field>
    <field name="constr_mandatory" eval="True"/>
    <field name="sequence">20</field>
    <field name="question_code">p2</field>
</record>
<record id="q_p2_a" model="survey.question.answer">
    <field name="question_id" ref="q_p2"/><field name="value">Por WhatsApp o llamadas sin registro</field>
    <field name="answer_score">0</field><field name="sequence">1</field>
</record>
<record id="q_p2_b" model="survey.question.answer">
    <field name="question_id" ref="q_p2"/><field name="value">Hojas de requisición en papel/Excel, aprobación por email</field>
    <field name="answer_score">3</field><field name="sequence">2</field>
</record>
<record id="q_p2_c" model="survey.question.answer">
    <field name="question_id" ref="q_p2"/><field name="value">Órdenes de compra con flujo digital de aprobación</field>
    <field name="answer_score">7</field><field name="sequence">3</field>
</record>
<record id="q_p2_d" model="survey.question.answer">
    <field name="question_id" ref="q_p2"/><field name="value">Integrado a inventario, precios actualizados y comparativa de proveedores</field>
    <field name="answer_score">10</field><field name="sequence">4</field>
</record>

<!-- P3 -->
<record id="q_p3" model="survey.question">
    <field name="survey_id" ref="survey_constructor_audit"/>
    <field name="title">¿Cómo mides el avance y liquidas a subcontratistas?</field>
    <field name="question_type">simple_choice</field>
    <field name="constr_mandatory" eval="True"/>
    <field name="sequence">30</field>
    <field name="question_code">p3</field>
</record>
<record id="q_p3_a" model="survey.question.answer">
    <field name="question_id" ref="q_p3"/><field name="value">Estimación visual o acuerdo verbal</field>
    <field name="answer_score">0</field><field name="sequence">1</field>
</record>
<record id="q_p3_b" model="survey.question.answer">
    <field name="question_id" ref="q_p3"/><field name="value">Reportes fotográficos en Excel, conciliación manual</field>
    <field name="answer_score">3</field><field name="sequence">2</field>
</record>
<record id="q_p3_c" model="survey.question.answer">
    <field name="question_id" ref="q_p3"/><field name="value">Mediciones firmadas, pero liquidación retrasada</field>
    <field name="answer_score">7</field><field name="sequence">3</field>
</record>
<record id="q_p3_d" model="survey.question.answer">
    <field name="question_id" ref="q_p3"/><field name="value">Validación digital con checklists y pagos por hitos reales</field>
    <field name="answer_score">10</field><field name="sequence">4</field>
</record>

