</record>
<record id="q_p5_d" model="survey.question.answer">
    <field name="question_id" ref="q_p5"/><field name="value">Integrado con alertas de ruta crítica y reprogramación automática</field>
    <field name="answer_score">10</field><field name="sequence">4</field>
</record>

